{
  "name": "hofchilbi",
  "private": true,
  "type": "module",
  "description": "Website and editor for Hofchilbi Wil. Content lives outside this repo.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",

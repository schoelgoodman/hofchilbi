{
  "name": "hofchilbi",
  "private": true,
  "type": "module",
  "description": "Website and editor for Hofchilbi Wil. Content lives outside this repo.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server/index.ts",
    "build": "tsc -p tsconfig.json && cp -R src/design/site.css src/design/site.js src/design/assets dist/design/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "start": "node dist/server/index.js",
    "import": "node scripts/import-webflow.ts"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.19.0",
    "node-html-parser": "^9.0.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "markdown-it": "^15.0.3",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
